#: script.p6.0x1a27
msgctxt "script.p6.0x1a27"
msgid "Hinweis: NW ---------------- NW Um die Haustür aufzuschließen, mußt du zu erst mit dem linken Mausknopf auf den Schlüssel klicken und dabei den Mausknopf gedrückt halten."
msgstr "Suggerimento: NW ---------------- NW Per sbloccare la porta d'ingresso, clicca sulla chiave con il tasto sinistro del mouse e tieni premuto."

#. prog 6 @ 1a92 op print_sentence
#: script.p6.0x1a92
msgctxt "script.p6.0x1a92"
msgid "Dann bewegst du den Mauscursor auf die Haustür und läßt erst dort den Mausknopf los."
msgstr "Poi sposta il cursore del mouse sulla porta d'ingresso e rilascia il tasto lì."

#. prog 8 @ 0173 op add_say_window2
#: script.p8.0x0173
msgctxt "script.p8.0x0173"
