msgstr "Wimp."

#. prog 13 @ 0b86 op add_say_window
#: script.p13.0x0b86
msgctxt "script.p13.0x0b86"
msgid "Arsch!"
msgstr "Asshole!"

#. prog 13 @ 0b92 op add_say_window
#: script.p13.0x0b92
msgctxt "script.p13.0x0b92"
msgid "Feigling!"
msgstr "Coward!"

#. prog 13 @ 0ba1 op add_say_window
#: script.p13.0x0ba1
msgctxt "script.p13.0x0ba1"
msgid "Arrogantes Schädlingsnest!"
msgstr "Nido arrogante di parassiti!"

#. prog 13 @ 0bbb op add_say_window
#: script.p13.0x0bbb
msgctxt "script.p13.0x0bbb"
msgid "Verweichlichter Fleischklumpen!"
msgstr "Morbido pezzo di carne!"

#. prog 13 @ 0bd6 op add_say_window
#: script.p13.0x0bd6
msgctxt "script.p13.0x0bd6"
msgid "(Heul!)"
msgstr "(Sobbing!)"

#. prog 13 @ 0be5 op add_say_window
#: script.p13.0x0be5
msgctxt "script.p13.0x0be5"
msgid "(Flenn!)"
msgstr "(Crying!)"

#. prog 13 @ 0bf4 op add_say_window
#: script.p13.0x0bf4
msgctxt "script.p13.0x0bf4"
msgid "(Schnief!)"
msgstr "(Sniff!)"

#. prog 13 @ 0c04 op add_say_window
#: script.p13.0x0c04
msgctxt "script.p13.0x0c04"
msgid "Tut mir leid, ich wollte nicht schon wieder gemein sein."
msgstr "Mi dispiace, non volevo essere cattivo di nuovo."

#. prog 13 @ 0c28 op add_say_window
#: script.p13.0x0c28
msgctxt "script.p13.0x0c28"
msgid "Schon ok."
msgstr "It's okay."

#. prog 13 @ 0c42 op add_option
#: script.p13.0x0c42
msgctxt "script.p13.0x0c42"
msgid "Ehm, hallo, Kaktus."
msgstr "Ehm, ciao, cactus."

#. prog 13 @ 0c5b op add_option
#: script.p13.0x0c5b
msgctxt "script.p13.0x0c5b"
msgid "Ich will nicht unhöflich sein, aber wieso kannst du sprechen?"
msgstr "Non voglio essere scortese, ma come fai a parlare?"

#. prog 13 @ 0c7e op add_option
#: script.p13.0x0c7e
msgctxt "script.p13.0x0c7e"
msgid "Du soltest dich mal wieder rasieren."
msgstr "Dovresti raderti ogni tanto."

#. prog 13 @ 0c98 op add_option
#: script.p13.0x0c98
msgctxt "script.p13.0x0c98"
msgid "So, jetzt bist plötzlich freundlich, du stinkendes Botanik-Objekt!"
msgstr "Quindi ora sei improvvisamente gentile, pezzo di botanica puzzolente!"

#. prog 13 @ 0ccc op add_option
#: script.p13.0x0ccc
msgctxt "script.p13.0x0ccc"
msgid "Kennst du diesen Dr. Ed? Wie ist der so?"
msgstr "Conosci questo Dott. Ed? Com'è fatto?"

#. prog 13 @ 0ceb op add_option
#: script.p13.0x0ceb
msgctxt "script.p13.0x0ceb"
msgid "Wußtest du, daß der Doc meine Freundin entführt hat? Warum tut der sowas?"
msgstr "Sapevi che il Doc ha rapito la mia ragazza? Perché l'avrebbe fatto?"

#. prog 13 @ 0d20 op add_option
#: script.p13.0x0d20
msgctxt "script.p13.0x0d20"
msgid "So, dieser Doktor ist also etwas verrückt.."
msgstr "Quindi questo dottore è un po' pazzo, allora..."

#. prog 13 @ 0d43 op add_option
#: script.p13.0x0d43
msgctxt "script.p13.0x0d43"
msgid "Was heißt, \"er kann telepathisch mit Gemüse reden\"?"
msgstr "Cosa intendi con \"può parlare telepaticamente con le verdure\"?"

#. prog 13 @ 0d6c op add_option
#: script.p13.0x0d6c
msgctxt "script.p13.0x0d6c"
msgid "Wieso kannst du eigentlich sprechen?"
msgstr "Come mai puoi parlare, comunque?"

#. prog 13 @ 0d87 op add_option
#: script.p13.0x0d87
msgctxt "script.p13.0x0d87"
msgid "Kennst du die Kaktee vor dem Haus?"
msgstr "Conosci il cactus davanti alla casa?"

#. prog 13 @ 0da3 op add_option
#: script.p13.0x0da3
msgctxt "script.p13.0x0da3"
msgid "Wie die Kaktee vor dem Haus aussieht? Sie ist etwas kleiner als du, hellgrün und hat eine rote Blüte."
msgstr "Com'è fatto il cactus davanti alla casa? È un po' più piccolo di te, verde chiaro, e ha un fiore rosso."

#. prog 13 @ 0de0 op add_option
#: script.p13.0x0de0
msgctxt "script.p13.0x0de0"
msgid "Was gibst du mir für ein Bild von der Kaktee?"
msgstr "Cosa mi dai per una foto del cactus?"

#. prog 13 @ 0e03 op add_option
#: script.p13.0x0e03
msgctxt "script.p13.0x0e03"
msgid "Wieso kann die Kaktee vor dem Haus eigentlich nicht reden?"
msgstr "Perché il cactus davanti alla casa non può parlare, comunque?"

#. prog 13 @ 0e29 op add_option
#: script.p13.0x0e29
msgctxt "script.p13.0x0e29"
msgid "Bis dann mal!"
msgstr "Ci vediamo in giro!"

#. prog 13 @ 0e82 op add_option
#: script.p13.0x0e82
msgctxt "script.p13.0x0e82"
msgid "Was hat es mit dieser Verdummungsmaschiene auf sich?"
msgstr "Che storia è questa macchina per imbecillire?"

#. prog 13 @ 0efc op add_say_window2
#: script.p13.0x0efc
msgctxt "script.p13.0x0efc"
msgid "Für 3 Jahre ohne rasieren sehe ich noch verdammt gut aus, finde ich."
msgstr "Sono tre anni che non mi rado e sono ancora dannatamente in forma, se me lo chiedi."

#. prog 13 @ 0f2d op say_if
#: script.p13.0x0f2d
msgctxt "script.p13.0x0f2d"
msgid "____Hi!____ NW Und noch einmal danke fürs Wasser.."
msgstr "____Ciao!____ NW E grazie ancora per l'acqua..."

#. prog 13 @ 0f63 op add_say_window
#: script.p13.0x0f63
msgctxt "script.p13.0x0f63"
msgid "Tja, das ist alles nur dieser Dr. Ed schuld. NW Ich bin ehrlich gesagt gar kein normaler Kaktus"
msgstr "Beh, è tutta colpa del Dott. Ed. NW A dire il vero, non sono affatto un cactus ordinario."

#. prog 13 @ 0fa1 op add_say_window
#: script.p13.0x0fa1
msgctxt "script.p13.0x0fa1"
msgid "Na das ist eine Überaschung."
msgstr "Beh, che sorpresa."

#. prog 13 @ 0fb4 op add_say_window
#: script.p13.0x0fb4
msgctxt "script.p13.0x0fb4"
msgid "Ich war damals Versicherungsvertreter. NW Ich hatte den Kerl keine 4 Stunden bearbeitet, schon schien er weich zu werden. NW Er bat mich ins Labor,.. NW ..und dann.. NW ..und dann.."
msgstr "Ero un venditore di assicurazioni. NW Lavoravo su quel tizio da meno di quattro ore quando ha iniziato a mollare. NW Mi ha invitato in laboratorio... NW ...e poi... NW ...e poi..."

#. prog 13 @ 1012 op add_say_window
#: script.p13.0x1012
msgctxt "script.p13.0x1012"
msgid "(schluchz!) NW ..dann hat er.. NW (schluchz!) NW Ich kann einfach nicht darüber sprechen. NW Aber du siehst das Ergebnis!"
msgstr "(singhiozzo!) NW ...poi lui... NW (singhiozzo!) NW Non riesco proprio a parlarne. NW Ma puoi vedere il risultato!"

#. prog 13 @ 106c op add_say_window
#: script.p13.0x106c
msgctxt "script.p13.0x106c"
msgid "Hey, noch lange kein Grund mich zu beschimpfen!"
msgstr "Ehi, non è un motivo per insultarmi!"

#. prog 13 @ 109d op add_say_window
#: script.p13.0x109d
msgctxt "script.p13.0x109d"
msgid "Der (zensiert) ist für meine jetzige Lage verantwortlich. NW Diesem (zensiert) (zensiert) sollte man (zensiert) in den (zensiert) und dann (sehr zensiert)."
msgstr "Il (censurato) è responsabile della mia situazione attuale. NW Quel (censurato) (censurato) dovrebbe essere (censurato) nel (censurato) e poi (pesantemente censurato)."

#. prog 13 @ 1100 op add_say_window
#: script.p13.0x1100
msgctxt "script.p13.0x1100"
msgid "Dieser (zensiert) (zensiert) (zensiert) (zensiert) (zensiert) (zensiert) (zensiert)!"
msgstr "Questo (censurato) (censurato) (censurato) (censurato) (censurato) (censurato) (censurato)!"

#. prog 13 @ 114f op add_say_window
#: script.p13.0x114f
msgctxt "script.p13.0x114f"
msgid "Der ist völlig geistesgestört! NW Er arbeitet im Keller an einer furchtbaren Erfindung. NW Und er entführt Menschen. NW An denen probiert er das Ding aus."
msgstr "È completamente pazzo! NW Sta lavorando a una terribile invenzione in cantina. NW E rapisce le persone. NW Le usa come cavie."

#. prog 13 @ 11ab op add_say_window
#: script.p13.0x11ab
msgctxt "script.p13.0x11ab"
msgid "Und die Weltherrschaft will er nicht übernehmen?"
msgstr "E non vuole conquistare il mondo?"

#. prog 13 @ 11cc op add_say_window
#: script.p13.0x11cc
msgctxt "script.p13.0x11cc"
msgid "Doch, daß natürlich auch. NW Du mußt ihn stoppen!"
msgstr "Certo che lo vuole anche lui. NW Devi fermarlo!"

#. prog 13 @ 11ee op say_if
#: script.p13.0x11ee
msgctxt "script.p13.0x11ee"
msgid "Etwas verrückt? NW Er es völlig abgedreht! NW Total ding dong! NW Bei dem weiß die linke Gehirnhälfte nicht, was die Rechte von ihr will! NW"
msgstr "Un po' pazzo? NW È completamente fuori di testa! NW Totalmente matto! NW Con lui, la metà sinistra del cervello non sa cosa vuole la destra! NW"

#. prog 13 @ 124e op say_if
#: script.p13.0x124e
msgctxt "script.p13.0x124e"
msgid "Der Mann kann telepathisch mit jeglichen Lebensmitteln in seinem Kühlschrank aufnehmen.. NW ..um diese ansschließend.. NW ..bestialisch.. NW ..in Ketchup zu ertränken!"
msgstr "L'uomo può comunicare telepaticamente con qualsiasi cibo nel suo frigorifero... NW ...così può poi... NW ...selvaggiamente... NW ...annegarglielo nel ketchup!"

#. prog 13 @ 12b7 op say_if
#: script.p13.0x12b7
msgctxt "script.p13.0x12b7"
msgid "Er hat im Keller einen Kühlschrank... NW Und er WEISS wenn etwas drin ist... NW ____Immer!____"
msgstr "Ha un frigorifero in cantina... NW E SA quando c'è qualcosa dentro... NW ____Sempre!____"

#. prog 13 @ 12ee op say_if
#: script.p13.0x12ee
msgctxt "script.p13.0x12ee"
msgid "Nein. Ich komm' nicht viel rum.. NW Aber erzähl mal! NW Wie sieht sie aus?"
msgstr "No. Non esco molto... NW Ma dimmi! NW Com'è fatta?"

#. prog 13 @ 1321 op say_if
#: script.p13.0x1321
msgctxt "script.p13.0x1321"
msgid "Mmmm, genau mein Typ. NW Meinst du, du könntest mir ein Bild von ihr besorgen?"
msgstr "Mmmm, proprio il mio tipo. NW Pensi di potermi procurare una sua foto?"

#. prog 13 @ 1359 op say_if
#: script.p13.0x1359
msgctxt "script.p13.0x1359"
msgid "Ich kenne die Kombination vom Kellerkühlschrank. NW Besorg mir ein Bild und ich sag sie Dir."
msgstr "Conosco la combinazione del frigorifero della cantina. NW Procurami una foto e te la dirò."

#. prog 13 @ 1399 op say_if
#: script.p13.0x1399
msgctxt "script.p13.0x1399"
msgid "Natürlich kann sie nicht reden! NW Es ist eine Kaktee. NW Kakteen können nicht reden!"
msgstr "Certo che non può parlare! NW È un cactus. NW I cactus non parlano!"

#. prog 13 @ 13c9 op say_if
#: script.p13.0x13c9
msgctxt "script.p13.0x13c9"
msgid "Die Verdummungsmaschiene! NW Er hat sie das erste Mal an seinem Sohn ausprobiert, aber der ist dadurch schlauer geworden. NW Es ist ein Gerät direkt aus der Hölle."
msgstr "La macchina per imbecillire! NW L'ha provata per la prima volta su suo figlio, ma l'ha reso più intelligente. NW È un dispositivo uscito dritto dall'inferno."

#. prog 13 @ 1437 op add_say_window
#: script.p13.0x1437
msgctxt "script.p13.0x1437"
msgid "Bis dann!"
msgstr "See you!"

#. prog 13 @ 1459 op add_option
#: script.p13.0x1459
msgctxt "script.p13.0x1459"
msgid "Wer bist du?"
msgstr "Chi sei?"

#. prog 13 @ 146a op add_option
#: script.p13.0x146a
msgctxt "script.p13.0x146a"
msgid "Was bist du ?"
msgstr "Cos'è?"

#. prog 13 @ 147c op add_option
#: script.p13.0x147c
msgctxt "script.p13.0x147c"
msgid "Ich meine, wieso kannst du sprechen."
msgstr "Voglio dire, come fai a parlare?"

#. prog 13 @ 1497 op add_option
#: script.p13.0x1497
msgctxt "script.p13.0x1497"
msgid "Warum läßt du mich nicht vorbei?"
msgstr "Perché non mi lasci passare?"

#. prog 13 @ 14b3 op add_option
#: script.p13.0x14b3
msgctxt "script.p13.0x14b3"
msgid "Warum rede ich mit einem Kaktus?"
msgstr "Perché sto parlando con un cactus?"

#. prog 13 @ 14cf op add_option
#: script.p13.0x14cf
msgctxt "script.p13.0x14cf"
msgid "Bleib doch da stehen, bis du grün wirst. Ich gehe!"
msgstr "Stai pure lì finché non diventi verde. Me ne vado!"

#. prog 13 @ 1529 op add_say_window
#: script.p13.0x1529
msgctxt "script.p13.0x1529"
msgid "Bist du blind? NW Ich bin ein Kaktus!"
msgstr "Sei cieco? NW Sono un cactus!"

#. prog 13 @ 1548 op add_say_window
#: script.p13.0x1548
msgctxt "script.p13.0x1548"
msgid "Das sehe ich selbst."
msgstr "Lo vedo da solo."

#. prog 13 @ 155a op add_say_window
#: script.p13.0x155a
msgctxt "script.p13.0x155a"
msgid "Was fragst du dann?!"
msgstr "Then why ask?!"

#. prog 13 @ 156d op say_if
#: script.p13.0x156d
msgctxt "script.p13.0x156d"
msgid "Ach, laß mich in Ruhe!"
msgstr "Oh, leave me alone!"

#. prog 13 @ 1582 op say_if
#: script.p13.0x1582
msgctxt "script.p13.0x1582"
msgid "Weil ich schlecht gelaunt bin! NW Ich bin heute echt übel drauf!"
msgstr "Perché sono di cattivo umore! NW Oggi sono davvero di umore pessimo!"

#. prog 13 @ 15ae op say_if
#: script.p13.0x15ae
msgctxt "script.p13.0x15ae"
msgid "Genauso gut könnte ich dich fragen, warum ich mit einem MENSCHEN rede!"
msgstr "Potrei benissimo chiederti perché sto parlando con un ESSERE UMANO!"

#. prog 13 @ 15f1 op add_say_window
#: script.p13.0x15f1
msgctxt "script.p13.0x15f1"
msgid "Werd' nicht frech!"
msgstr "Don't get cheeky!"

#. prog 13 @ 1603 op add_say_window
#: script.p13.0x1603
msgctxt "script.p13.0x1603"
msgid "__Au!__"
msgstr "__Ow!__"

