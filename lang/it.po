#. prog 13 @ 1f38 op add_say_window
#: script.p13.0x1f38
msgctxt "script.p13.0x1f38"
msgid "Das hast du schon getan!"
msgstr "Lo hai già fatto!"

#. prog 13 @ 1f4a op add_say_window
#: script.p13.0x1f4a
msgctxt "script.p13.0x1f4a"
msgid "Stimmt! NW Und ich tu es noch einmal!"
msgstr "Esatto! NW E lo farò di nuovo!"

#. prog 13 @ 1f68 op add_say_window
