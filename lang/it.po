msgid "_"
msgstr "_"

#. prog 8 @ 02d3 op add_say_window2
#: script.p8.0x02d3
msgctxt "script.p8.0x02d3"
msgid "CLR Das ist Matt, von seinen Freunden auch 'Schrank' genannt. Er ist stark und, ehm. Na ja stark eben."
msgstr "CLR This is Matt, also known as 'Wardrobe' to his friends. He's strong and, um... well, strong, basically."

#. prog 8 @ 0317 op add_say_window2
#: script.p8.0x0317
msgctxt "script.p8.0x0317"
msgid "Wie? Was? Klar. Ich komm' mit. Auch wenn ich nicht weiß, wohin.."
msgstr "Cosa? Eh? Certo. Vengo, anche se non so dove stiamo andando..."

#. prog 8 @ 038e op add_say_window2
#: script.p8.0x038e
msgctxt "script.p8.0x038e"
msgid "CLR Das ist Terry. Er studiert Elektrotechnik, Elektronik und Teilchen-Physik."
msgstr "CLR Questo è Terry. Studia ingegneria elettrica, elettronica e fisica delle particelle."

#. prog 8 @ 03c9 op add_say_window2
#: script.p8.0x03c9
msgctxt "script.p8.0x03c9"
msgid "Heute nicht, Jack. Mir ist gerade mein eigene Freundin Mandy weggelaufen.."
msgstr "Non oggi, Jack. La mia ragazza Mandy mi ha appena piantato..."

#. prog 8 @ 042c op add_say_window2
#: script.p8.0x042c
msgctxt "script.p8.0x042c"
msgid "CLR Das ist Ron. Ron mixt die besten Drinks in der Stadt und ist auf jeder Party zu finden."
msgstr "CLR Questo è Ron. Ron prepara i migliori drink della città e si trova a ogni festa."

#. prog 8 @ 0467 op add_say_window2
#: script.p8.0x0467
msgctxt "script.p8.0x0467"
msgid "Da ist heute noch diese Fete bei Alice, sonst würde ich gerne mitkommen, ist doch klar."
msgstr "C'è quella festa da Alice stasera; altrimenti verrei volentieri, ovviamente."

#. prog 8 @ 04d2 op add_say_window2
#: script.p8.0x04d2
msgctxt "script.p8.0x04d2"
msgid "CLR Das ist Amanda. Sie ist ein wenig ängstlich und schüchtern, aber dafür auch sehr unauffällig."
msgstr "CLR Questa è Amanda. È un po' nervosa e timida, ma si fa anche notare poco."

#. prog 8 @ 0507 op add_say_window2
#: script.p8.0x0507
msgctxt "script.p8.0x0507"
msgid "Danke für dein Vertrauen Jack, aber das ist mir zu gefährlich."
msgstr "Grazie per la fiducia, Jack, ma è troppo pericoloso per me."

#. prog 8 @ 055f op add_say_window2
#: script.p8.0x055f
msgctxt "script.p8.0x055f"
msgid "CLR Das ist Drive. Wenn er nicht gerade sein Motorrad repariert, fährt er es zu Schrott. NW Er ist stark und hat vor nichts Angst."
msgstr "CLR Questo è Drive. Quando non sta riparando la sua moto, la sta distruggendo. NW È forte e non ha paura di niente."

#. prog 8 @ 05ab op add_say_window2
#: script.p8.0x05ab
msgctxt "script.p8.0x05ab"
msgid "Sorry, Jack, aber ich will erst mal meinen Vergaser wieder ganz hämmern."
msgstr "Scusa, Jack, ma prima voglio far funzionare di nuovo il mio carburatore."

#. prog 8 @ 060b op add_say_window2
#: script.p8.0x060b
msgctxt "script.p8.0x060b"
msgid "CLR Das ist Ronda. Sie will Ärtztin, Schriftstellerin, Schauspielerin und Fotomodell werden."
msgstr "CLR Questa è Ronda. Vuole diventare medico, scrittrice, attrice e modella."

#. prog 8 @ 0647 op add_say_window2
#: script.p8.0x0647
msgctxt "script.p8.0x0647"
msgid "Klar komme ich mit Jack. Aber nur Sandy zu liebe, ist das klar?"
msgstr "Certo che vengo, Jack. Ma solo per Sandy, chiaro?"

#. prog 8 @ 0720 op add_say_window
#: script.p8.0x0720
msgctxt "script.p8.0x0720"
msgid "Also. Ihr wisst, warum ihr hier seit!"
msgstr "Ok. Sai perché sei qui!"

#. prog 8 @ 0740 op add_say_window
#: script.p8.0x0740
msgctxt "script.p8.0x0740"
msgid "___Nö.___"
msgstr "___Nope.___"

#. prog 8 @ 0756 op add_say_window
#: script.p8.0x0756
msgctxt "script.p8.0x0756"
msgid "Aber Matt, wir wollen Sandy retten!"
msgstr "Ma Matt, vogliamo salvare Sandy!"

#. prog 8 @ 0773 op add_say_window
#: script.p8.0x0773
msgctxt "script.p8.0x0773"
msgid "Ich dachte wir wollten zum Strand..."
msgstr "Pensavo stessimo andando in spiaggia..."

#. prog 8 @ 078e op add_say_window
#: script.p8.0x078e
msgctxt "script.p8.0x078e"
msgid "Später, Matt. Erst kommt Ronda."
msgstr "Più tardi, Matt. Prima viene Ronda."

#. prog 8 @ 07a9 op add_say_window
#: script.p8.0x07a9
msgctxt "script.p8.0x07a9"
msgid "Aber ich wollte mich dort mit Ron treffen..."
msgstr "Ma dovevo incontrare Ron lì..."

#. prog 8 @ 07c8 op add_say_window
#: script.p8.0x07c8
msgctxt "script.p8.0x07c8"
msgid "__ÄHEM.__"
msgstr "__AHEM.__"

#. prog 8 @ 07de op add_say_window
#: script.p8.0x07de
msgctxt "script.p8.0x07de"
msgid "Also, Ich habe gesehen wie Dr.Ed Sandy ins Haus gebracht hat, und daher.."
msgstr "Beh, ho visto il Dott. Ed portare Sandy in casa, e quindi..."

#. prog 8 @ 080e op add_say_window
#: script.p8.0x080e
msgctxt "script.p8.0x080e"
msgid "Was steht da auf dem Schild, Ronda?"
msgstr "Cosa dice quel cartello, Ronda?"

#. prog 8 @ 082a op add_say_window
#: script.p8.0x082a
msgctxt "script.p8.0x082a"
msgid "Da steht: NW Warnung! NW Das Haus ist baufällig, radioaktiv verseucht und von Zombies belagert. NW Und giftig. NW Und Privatbesitz. NW Eltern zahlen die Beerdigungskosten für ihre Kinder."
msgstr "Dice: NW Attenzione! NW Questa casa è strutturalmente instabile, contaminata da radioattività e circondata da zombie. NW E velenosa. NW E proprietà privata. NW I genitori pagano le spese funebri dei loro figli."

#. prog 8 @ 08bd op add_say_window2
#: script.p8.0x08bd
msgctxt "script.p8.0x08bd"
msgid "Ich muß jetzt gehen!"
msgstr "Devo andare ora!"

#. prog 8 @ 08d0 op add_say_window2
#: script.p8.0x08d0
msgctxt "script.p8.0x08d0"
msgid "__Ich auch.__"
msgstr "__Me too.__"

#. prog 8 @ 08e4 op add_say_window
#: script.p8.0x08e4
