msgid "--KREIIIISCH!-- NW --KREIIIISCH!-"
msgstr "--SCREEEEAM!-- NW --SCREEEEAM!--"

#. prog 13 @ 1781 op add_say_window
#: script.p13.0x1781
msgctxt "script.p13.0x1781"
msgid "Sag mal, was bezweckst du eigentlich damit?"
msgstr "Zeg eens, wat probeer je hiermee te bereiken?"

#. prog 13 @ 179f op add_say_window
#: script.p13.0x179f
msgctxt "script.p13.0x179f"
msgid "Ich will den Schlüssel, der dort oben hängt."
msgstr "Ik wil die sleutel die daar boven hangt."

#. prog 13 @ 17b9 op add_say_window
#: script.p13.0x17b9
msgctxt "script.p13.0x17b9"
msgid "Den kannst du nicht haben. NW Aber nimm doch den hier!"
msgstr "Die kun je niet hebben. NW Maar neem deze!"

#. prog 13 @ 17dd op add_say_window
#: script.p13.0x17dd
msgctxt "script.p13.0x17dd"
msgid "___Danke.___"
msgstr "___Thanks.___"

