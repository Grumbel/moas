#. prog 25 @ 077b op add_say_window
#: script.p25.0x077b
msgctxt "script.p25.0x077b"
msgid "___Korrekt!___ NW Sie haben einen Koffer voller Geld gewonnen!"
msgstr "___Correct!___ NW Je hebt een koffer vol geld gewonnen!"

#. prog 25 @ 07fb op add_say_window
#: script.p25.0x07fb
msgctxt "script.p25.0x07fb"
msgid "Was sagen Sie nun, Jack!"
msgstr "Nou, wat zeg je nu, Jack?"

#. prog 25 @ 0810 op add_say_window
#: script.p25.0x0810
msgctxt "script.p25.0x0810"
msgid "Eigentlich bräuchte ich ja nur den Koffer. NW Ich meine, wenn das ginge..."
msgstr "Eigenlijk heb ik alleen de koffer nodig. NW Ik bedoel, als dat zou kunnen..."

#. prog 26 @ 0013 op set_room_name
#: script.p26.0x0013
msgctxt "script.p26.0x0013"
msgid "Showdown"
msgstr "Showdown"

#. prog 26 @ 009f op add_say_window
#: script.p26.0x009f
msgctxt "script.p26.0x009f"
msgid "____(13_Punkte)____"
msgstr "____(13_Punten)____"

#. prog 26 @ 00b2 op add_say_window2
#: script.p26.0x00b2
msgctxt "script.p26.0x00b2"
msgid "____Sandy!____ NW Halt durch, ich komme und rette dich!"
msgstr "____Sandy!____ NW Houd vol, ik kom je redden!"

#. prog 26 @ 00e8 op add_say_window
#: script.p26.0x00e8
msgctxt "script.p26.0x00e8"
msgid "CLR Du bist ja gar nicht Sandy!"
msgstr "CLR Jij bent helemaal geen Sandy!"

#. prog 26 @ 0111 op add_say_window2
#: script.p26.0x0111
msgctxt "script.p26.0x0111"
msgid "Was geht hier vor?"
msgstr "Wat is hier aan de hand?"

#. prog 26 @ 0134 op add_say_window
#: script.p26.0x0134
msgctxt "script.p26.0x0134"
msgid "CLR Ich bin gekommen um meine Freundin zu retten!"
msgstr "CLR Ik ben gekomen om mijn vriendin te redden!"

#. prog 26 @ 0158 op add_say_window
#: script.p26.0x0158
msgctxt "script.p26.0x0158"
msgid "CLR Würde mich bitte hier jemand losbinden?"
msgstr "CLR Zou iemand me alsjeblieft los willen maken?"

#. prog 26 @ 017d op add_say_window
#: script.p26.0x017d
msgctxt "script.p26.0x017d"
msgid "CLR Wo ist meine Freundin!?"
msgstr "CLR Waar is mijn vriendin!?"

#. prog 26 @ 0197 op add_say_window
#: script.p26.0x0197
msgctxt "script.p26.0x0197"
msgid "CLR Würdest du mich bitte losbinden!"
msgstr "CLR Zou je me alsjeblieft los willen maken!"

#. prog 26 @ 01b4 op add_say_window
#: script.p26.0x01b4
msgctxt "script.p26.0x01b4"
msgid "CLR Ruhe!"
msgstr "CLR Stil!"

#. prog 26 @ 01c4 op add_say_window
#: script.p26.0x01c4
msgctxt "script.p26.0x01c4"
msgid "CLR Willst du sie jetzt retten oder nicht?"
msgstr "CLR Wil je haar nu redden of niet?"

#. prog 26 @ 01e0 op add_say_window
#: script.p26.0x01e0
msgctxt "script.p26.0x01e0"
msgid "CLR Ich suche Sandy! NW Was haben Sie mit Sandy gemacht!?"
msgstr "CLR Ik zoek Sandy! NW Wat heb je met Sandy gedaan?!"

#. prog 26 @ 0205 op add_say_window
#: script.p26.0x0205
msgctxt "script.p26.0x0205"
msgid "CLR ___Sandy?___ NW Die habe ich in eine Kaktee verwandelt!"
msgstr "CLR ___Sandy?___ NW Ik heb haar in een cactus veranderd!"

#. prog 26 @ 022f op add_say_window
#: script.p26.0x022f
msgctxt "script.p26.0x022f"
msgid "CLR SIE HABEN WAS....!?"
msgstr "CLR JIJ HEBT WAT....!?"

#. prog 26 @ 024c op add_say_window
#: script.p26.0x024c
msgctxt "script.p26.0x024c"
msgid "CLR Ganz richtig, mit der Maschine dort rechts. NW Deine Freundin steht jetzt im Vorgarten. NW Und DICH werde ich jetzt entgültig zerstrahlen!"
msgstr "CLR Precies, met die machine daar rechts. NW Je vriendin staat nu in de voortuin. NW En JOU ga ik nu definitief verstralen!"

#. prog 26 @ 02e3 op add_say_window
#: script.p26.0x02e3
msgctxt "script.p26.0x02e3"
msgid "____Halt!____"
msgstr "____Halt!____"

#. prog 26 @ 02f1 op add_say_window
#: script.p26.0x02f1
msgctxt "script.p26.0x02f1"
msgid "Leg die Waffe weg! NW Du weißt nicht, was du da in der Hand hast!"
msgstr "Leg het wapen neer! NW Je weet niet wat je in handen hebt!"

#. prog 26 @ 031f op add_say_window
#: script.p26.0x031f
msgctxt "script.p26.0x031f"
msgid "Das ist für Sandy!"
msgstr "Dit is voor Sandy!"

#. prog 26 @ 034b op add_say_window2
#: script.p26.0x034b
msgctxt "script.p26.0x034b"
msgid "____Ahhh!____"
msgstr "____Ahhh!____"

#. prog 26 @ 0378 op add_say_window
#: script.p26.0x0378
msgctxt "script.p26.0x0378"
msgid "Was hast du getan? NW _____OH_NEIN!_____"
msgstr "Wat heb je gedaan? NW _____OH_NEE!_____"

