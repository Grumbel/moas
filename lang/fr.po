msgstr "_"

#: script.p14.0x025f
msgctxt "script.p14.0x025f"
msgid "Ja. Und das war's."
msgstr "Yes. And that's it."

#: script.p14.0x028e
msgctxt "script.p14.0x028e"
msgid "Und jetzt zu dir!"
msgstr "And now, on to you!"

#: script.p14.0x048a
msgctxt "script.p14.0x048a"
msgid "_"
msgstr "_"

