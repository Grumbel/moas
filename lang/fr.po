msgctxt "script.p2.0x0cf3"
msgid "CLR Yeah yeah yeah!"
msgstr "CLR Yeah yeah yeah !"

#. prog 2 @ 0d0e
#: script.p2.0x0d0e
msgctxt "script.p2.0x0d0e"
msgid "CLR Was ein Gekreische!"
msgstr "CLR Quel vacarme !"

#. prog 2 @ 0d30
#: script.p2.0x0d30
msgctxt "script.p2.0x0d30"
msgid "CLR Gluck. Gluck. Gluck."
msgstr "CLR Glouglou. Glouglou. Glouglou."

#. prog 2 @ 0d6c
#: script.p2.0x0d6c
msgctxt "script.p2.0x0d6c"
msgid "CLR Der Koffer ist voller Geld!"
msgstr "CLR La valise est pleine d'argent !"

#. prog 2 @ 0d96
#: script.p2.0x0d96
msgctxt "script.p2.0x0d96"
msgid "Und da ist ja auch meine Diskette."
msgstr "Et voilà aussi ma disquette."

#. prog 2 @ 0dc4
#: script.p2.0x0dc4
msgctxt "script.p2.0x0dc4"
msgid "CLR Da ist ja meine Diskette"
msgstr "CLR Voilà ma disquette"

#. prog 2 @ 0de5
#: script.p2.0x0de5
msgctxt "script.p2.0x0de5"
msgid "CLR Der Koffer ist leer."
msgstr "CLR La valise est vide."

#. prog 2 @ 0e0c
#: script.p2.0x0e0c
msgctxt "script.p2.0x0e0c"
msgid "CLR Soll ich ihn essen, oder was?"
msgstr "CLR Je dois le manger, ou quoi ?"

#. prog 2 @ 0e53
#: script.p2.0x0e53
msgctxt "script.p2.0x0e53"
msgid "CLR Nette Papierschnipsel!"
msgstr "CLR Jolis petits bouts de papier !"

#. prog 2 @ 0e84
#: script.p2.0x0e84
msgctxt "script.p2.0x0e84"
msgid "CLR Nette Papierschnipsel!"
msgstr "CLR Jolis petits bouts de papier !"

#. prog 2 @ 0eb5
#: script.p2.0x0eb5
msgctxt "script.p2.0x0eb5"
msgid "CLR Nette Papierschnipsel!"
msgstr "CLR Jolis petits bouts de papier !"

#. prog 2 @ 0ee6
