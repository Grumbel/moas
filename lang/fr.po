msgid "_"
msgstr "_"

#: script.p17.0x00c2
msgctxt "script.p17.0x00c2"
msgid "CLR Ein Buch."
msgstr "CLR A book."

#: script.p17.0x00ee
msgctxt "script.p17.0x00ee"
msgid "Ok."
msgstr "Ok."

#: script.p17.0x0111
msgctxt "script.p17.0x0111"
msgid "CLR Ein alter, gemauerter Kamin."
msgstr "CLR An old brick fireplace."

#: script.p17.0x012d
msgctxt "script.p17.0x012d"
msgid "Aber klar. Wohin soll ich den Kamin tragen?"
msgstr "Bien sûr. Où suis-je censé porter la cheminée ?"

#: script.p17.0x015f
msgctxt "script.p17.0x015f"
msgid "CLR Die Asche ist noch warm."
msgstr "CLR Les cendres sont encore chaudes."

#: script.p17.0x018a
msgctxt "script.p17.0x018a"
msgid "CLR Ich bin doch nicht lebensmüde!"
msgstr "CLR Je ne suis pas suicidaire !"

#: script.p17.0x01b7
msgctxt "script.p17.0x01b7"
msgid "CLR Das brauche ich vielleicht noch!"
msgstr "CLR J'en aurai peut-être encore besoin !"

#: script.p17.0x01ea
msgctxt "script.p17.0x01ea"
msgid "CLR Die Tür ist völlig verstaubt. NW Die hat schon lange niemand mehr geöffnet."
msgstr "CLR La porte est complètement couverte de poussière. NW Personne ne l'a ouverte depuis longtemps."

#: script.p17.0x08b7
msgctxt "script.p17.0x08b7"
msgid "CLR Was für ein altes Teil. NW Der haut einem ja das Amalgan aus den Plomben!"
msgstr "CLR Quel vieux truc. NW Ça fait trembler les plombages !"

#: script.p17.0x08f9
msgctxt "script.p17.0x08f9"
msgid "CLR Der Monitor hat nur einen Knopf und der ist kaputt."
msgstr "CLR Le moniteur n'a qu'un bouton, et il est cassé."

#: script.p17.0x0935
msgctxt "script.p17.0x0935"
msgid "CLR Nette Idee. NW Aber der Computer ist Idiotensicher und Wasserdicht."
msgstr "CLR Belle idée. NW Mais l'ordinateur est idiot-proof et étanche."

#: script.p18.0x0094
msgctxt "script.p18.0x0094"
msgid "Du weist nicht was, aber in diesem Raum ist irgendetwas sehr sehr großes und sehr sehr böses. Du hörst ein elektrisches Summen und riechst die verbrauchte Elektrizität wie bei einem alten Eisenbahntrafo."
msgstr "Tu ne sais pas ce que c'est, mais quelque chose de très très grand et de très très maléfique est dans cette pièce. Tu entends un bourdonnement électrique et tu sens l'électricité usée, comme un vieux transformateur de chemin de fer."

#: script.p18.0x0117
msgctxt "script.p18.0x0117"
msgid "CLR Da ist eine Öffnung in der Maschine. NW Eine rote Kruste ist darin zu erkennen!"
msgstr "CLR Il y a une ouverture dans la machine. NW On voit une croûte rouge à l'intérieur !"

#: script.p18.0x015c
msgctxt "script.p18.0x015c"
msgid "CLR Was soll ich damit machen?"
msgstr "CLR Qu'est-ce que je suis censé faire avec ça ?"

#: script.p18.0x0186
msgctxt "script.p18.0x0186"
msgid "CLR Ich fürchte das Werk des Teufels hat keinen Mausanschluß."
msgstr "CLR J'ai bien peur que l'œuvre du diable n'ait pas de port souris."

#: script.p18.0x01c7
msgctxt "script.p18.0x01c7"
msgid "CLR Aber klar doch. NW Damit werde ich diesem Gigant so richtig zeigen!"
msgstr "CLR Bien sûr. NW Je vais montrer à ce géant de quel bois je me chauffe !"

#: script.p18.0x0216
msgctxt "script.p18.0x0216"
msgid "CLR Friß das, du Höllenmaschine!"
msgstr "CLR Prends ça, satanée machine !"

#: script.p18.0x023e
msgctxt "script.p18.0x023e"
msgid "____(10_Punkte)____"
msgstr "____(10_Points)____"

#: script.p18.0x02bf
msgctxt "script.p18.0x02bf"
msgid "Uh-oh....."
msgstr "Uh-oh....."

#: script.p18.0x02cf
msgctxt "script.p18.0x02cf"
msgid "Was war denn das für ein Lärm?!?!?"
msgstr "C'était quoi ce bruit ?!?!?"

#: script.p18.0x033e
msgctxt "script.p18.0x033e"
msgid "Grunz??"
msgstr "Grunt??"

#: script.p18.0x037c
msgctxt "script.p18.0x037c"
msgid "_______Tssss!_______ NW Hat dieser Kerl doch glatt meine 1.1 Gigawatt Mikrowelle gesprengt! NW ---Seufz--- NW Bevor ich die nicht repariert habe, gibt es keine Pizza."
msgstr "_______Tssss!_______ NW That guy actually blew up my 1.1-gigawatt microwave! NW ---Sigh--- NW No pizza until I've repaired it."

#: script.p18.0x0426
msgctxt "script.p18.0x0426"
msgid "CLR Ein Lichtschalter"
msgstr "CLR A light switch"

#: script.p18.0x04d1
msgctxt "script.p18.0x04d1"
msgid "Das Werk des Teufels. Es ist diese furchtbare Maschine (da bist du dir sicher), die den armen Doc in einen Wahnsinnigen verwandelt hat. Tausenden von Lämpchen blinken."
msgstr "L'œuvre du diable. Tu es sûr que cette terrible machine est ce qui a transformé le pauvre Doc en fou. Des milliers de petites lumières clignotent."

#: script.p18.0x0531
msgctxt "script.p18.0x0531"
msgid "Du hörst das Summen von Elektronen in maroden Kupferdrähten und der Geruch von durchgebrannten Sicherungen sticht in deiner Nase."
msgstr "Tu entends les électrons bourdonner dans des fils de cuivre délabrés, et l'odeur des fusibles grillés te pique le nez."

#: script.p18.0x057b
msgctxt "script.p18.0x057b"
msgid "CLR Ich muß diese Maschine irgendwie vernichten!"
msgstr "CLR Je dois détruire cette machine d'une façon ou d'une autre !"

#: script.p18.0x0609
msgctxt "script.p18.0x0609"
msgid "Wen haben wir denn da?"
msgstr "Who do we have here?"

#: script.p19.0x0197
msgctxt "script.p19.0x0197"
msgid "Aber klar. Wohin soll ich den Kamin tragen?"
msgstr "Bien sûr. Où suis-je censé porter la cheminée ?"

#: script.p19.0x01b6
msgctxt "script.p19.0x01b6"
msgid "CLR Ein alter, gemauerter Kamin."
msgstr "CLR An old brick fireplace."

#: script.p19.0x01e5
msgctxt "script.p19.0x01e5"
msgid "CLR Was soll ich denn anzünden?"
msgstr "CLR Qu'est-ce que je suis censé allumer ?"

#: script.p19.0x0214
msgctxt "script.p19.0x0214"
msgid "CLR Ich hab's ja."
msgstr "CLR I've got it."

#: script.p19.0x0279
msgctxt "script.p19.0x0279"
msgid "CLR Und noch mehr rein."
msgstr "CLR And put some more in."

#: script.p19.0x02a3
msgctxt "script.p19.0x02a3"
msgid "Alles rein da."
msgstr "Put it all in!"

#: script.p19.0x0355
msgctxt "script.p19.0x0355"
msgid "____Oh!____"
msgstr "____Oh!____"

#: script.p19.0x0367
msgctxt "script.p19.0x0367"
msgid "Jetzt hab ich's nicht mehr..."
msgstr "I've lost it now..."

#: script.p19.0x0391
msgctxt "script.p19.0x0391"
msgid "Was soll der Geiz - alles rein da."
msgstr "Pourquoi être avare - tout dedans."

#: script.p19.0x0459
msgctxt "script.p19.0x0459"
msgid "Wie soll ich das dem Finanzamt erklären???"
msgstr "Comment je vais expliquer ça au fisc ???"

#: script.p19.0x048c
msgctxt "script.p19.0x048c"
msgid "CLR Ich bin doch nicht lebensmüde!"
msgstr "CLR Je ne suis pas suicidaire !"

#: script.p19.0x04b9
msgctxt "script.p19.0x04b9"
msgid "CLR Das brauche ich vielleicht noch!"
msgstr "CLR J'en aurai peut-être encore besoin !"

#: script.p19.0x04f7
msgctxt "script.p19.0x04f7"
msgid "CLR Eine Computermaus für den seriellen Port. Drei Tasten. Stoßgedämpfe, langlebige Mikroschalter. Umschaltbar für MS und PC Modus."
msgstr "CLR Une souris d'ordinateur pour le port série. Trois boutons. Micro-interrupteurs amortis et durables. Commutable entre mode MS et PC."

#: script.p19.0x0555
msgctxt "script.p19.0x0555"
msgid "Mit sowas kenne ich mich aus."
msgstr "Je m'y connais en ce genre de choses."

#: script.p19.0x056e
msgctxt "script.p19.0x056e"
msgid "Das hat keinen Sinn. Der Computer ist völlig mit Viren verseucht und zu keiner Reaktion fähig."
msgstr "Ça n'a aucun sens. L'ordinateur est tellement infecté de virus qu'il ne réagit plus à rien."

#: script.p19.0x05c1
msgctxt "script.p19.0x05c1"
msgid "CLR Ok."
msgstr "CLR Ok."

#: script.p19.0x05d5
msgctxt "script.p19.0x05d5"
msgid "____(2_Punkte)____"
msgstr "____(2 points)____"

#: script.p19.0x060a
msgctxt "script.p19.0x060a"
msgid "CLR Wow! Was ein Kalender!"
msgstr "CLR Wow ! Quel calendrier !"

#: script.p19.0x0640
msgctxt "script.p19.0x0640"
msgid "CLR Ok."
msgstr "CLR Ok."

#: script.p19.0x0654
msgctxt "script.p19.0x0654"
msgid "____(2_Punkte)____"
msgstr "____(2 points)____"

#: script.p19.0x069f
msgctxt "script.p19.0x069f"
msgid "CLR Der Safe wird offensichtlich mit einem Schlüssel geöffnet."
msgstr "CLR Le coffre est clairement ouvert avec une clé."

#: script.p19.0x06d2
msgctxt "script.p19.0x06d2"
msgid "CLR Der Safe ist leer"
msgstr "CLR Le coffre est vide"

#: script.p19.0x0706
msgctxt "script.p19.0x0706"
msgid "CLR Ich bin nicht der böse Wolf, der eben mal die Wand umpusten kann!"
msgstr "CLR Je ne suis pas le grand méchant loup qui peut souffler un mur d'un coup !"

#: script.p19.0x073e
msgctxt "script.p19.0x073e"
msgid "CLR Der Safe ist leer."
msgstr "CLR Le coffre est vide."

#: script.p19.0x0768
msgctxt "script.p19.0x0768"
msgid "CLR Der Schlüssel passt nicht."
msgstr "CLR La clé ne rentre pas."

#: script.p19.0x0793
msgctxt "script.p19.0x0793"
msgid "CLR Ich bin kein Safeknacker!"
msgstr "CLR Je ne suis pas un crocheteur de coffres !"

#: script.p19.0x07d7
msgctxt "script.p19.0x07d7"
msgid "CLR Im Safe liegt eine Kreditkarte und ein Holzkeil!"
msgstr "CLR Dans le coffre il y a une carte de crédit et une cale en bois !"

#: script.p19.0x080e
msgctxt "script.p19.0x080e"
msgid "____(5_Punkte)____"
msgstr "____(5 points)____"

#: script.p19.0x0853
msgctxt "script.p19.0x0853"
msgid "CLR Da sind diverse Disketten mit Raubkopieen im Kasten. NW Bestimmt alles mit Viren verseucht."
msgstr "CLR Il y a diverses disquettes de copies pirates dans la boîte. NW Sûrement toutes infectées de virus."

#: script.p19.0x0891
msgctxt "script.p19.0x0891"
msgid "CLR Der Computer ist so mit Viren verseucht, daß da nicht mal mehr Tetris läuft."
msgstr "CLR L'ordinateur est tellement infecté de virus que même Tetris ne tourne plus."

#: script.p19.0x08e2
msgctxt "script.p19.0x08e2"
msgid "CLR Danke, ich habe noch eine."
msgstr "CLR Merci, j'en ai encore une."

#: script.p19.0x0906
msgctxt "script.p19.0x0906"
msgid "CLR Danke, vielleicht später."
msgstr "CLR Merci, peut-être plus tard."

#: script.p19.0x095c
msgctxt "script.p19.0x095c"
msgid "CLR Ok."
msgstr "CLR Ok."

#: script.p19.0x0970
msgctxt "script.p19.0x0970"
msgid "____(2_Punkte)____"
msgstr "____(2 points)____"

#: script.p20.0x016b
msgctxt "script.p20.0x016b"
msgid "CLR Das WAR eng! NW ZU eng für das Glas."
msgstr "CLR C'était SERRÉ ! NW TROP serré pour le verre."

#: script.p20.0x01a5
msgctxt "script.p20.0x01a5"
msgid "Unmöglich! Der wiegt Tonnen."
msgstr "Impossible ! Ça pèse des tonnes."

#: script.p20.0x01cb
msgctxt "script.p20.0x01cb"
msgid "CLR Ich weiß nicht, ob das ein Tresor oder ein Kühlschrank seien soll."
msgstr "CLR Je ne sais pas si c'est censé être un coffre ou un réfrigérateur."

#: script.p20.0x0218
msgctxt "script.p20.0x0218"
msgid "____Okay,...____ NW ____1-2-3-4-5-6____ NW Simsalabim, der Safe ist offen."
msgstr "____Okay,...____ NW ____1-2-3-4-5-6____ NW Abracadabra, le coffre est ouvert."

#: script.p20.0x0266
msgctxt "script.p20.0x0266"
msgid "____(3_Punkte)____"
msgstr "____(3_points)____"

#: script.p20.0x0279
msgctxt "script.p20.0x0279"
msgid "CLR Ich weiß die Kombination nicht."
msgstr "CLR Je ne connais pas la combinaison."

#: script.p20.0x0297
msgctxt "script.p20.0x0297"
msgid "Dazu muß der Safe erst einmal offen sein."
msgstr "Le coffre doit d'abord être ouvert."

#: script.p20.0x02cc
msgctxt "script.p20.0x02cc"
msgid "CLR Der Kühlschrank ist leer."
msgstr "CLR Le réfrigérateur est vide."

#: script.p20.0x0309
msgctxt "script.p20.0x0309"
msgid "CLR Hey, Toastbrot!"
msgstr "CLR Hé, du toast !"

#: script.p20.0x0504
msgctxt "script.p20.0x0504"
msgid "CLR Okay!"
msgstr "CLR Okay !"

#: script.p20.0x0538
msgctxt "script.p20.0x0538"
msgid "Der Kühlschrank ist voll."
msgstr "Le réfrigérateur est plein."

#: script.p20.0x084b
msgctxt "script.p20.0x084b"
msgid "CLR Eine Art Computer-Schloß sichert die Tür."
msgstr "CLR Une sorte de serrure informatique sécurise la porte."

#: script.p20.0x086f
msgctxt "script.p20.0x086f"
msgid "CLR Eine altes, verrostetes Schloß sichert die Tür."
msgstr "CLR Une vieille serrure rouillée sécurise la porte."

#: script.p20.0x0893
msgctxt "script.p20.0x0893"
msgid "CLR Die Tür ist elektronisch verriegelt."
msgstr "CLR La porte est verrouillée électroniquement."

#: script.p20.0x08f0
msgctxt "script.p20.0x08f0"
msgid "CLR Das elektronische Schloß scheint außer Betrieb zu sein."
msgstr "CLR La serrure électronique semble hors service."

#: script.p20.0x0926
