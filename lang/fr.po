msgstr "CLR La disquette a fondu..."

#: script.p20.0x1105
msgctxt "script.p20.0x1105"
msgid "CLR Und Tschüss!"
msgstr "CLR Et au revoir !"

#: script.p20.0x1183
msgctxt "script.p20.0x1183"
msgid "CLR Das Loch ist bodenlos."
msgstr "CLR Le trou est sans fond."

#: script.p20.0x11bc
msgctxt "script.p20.0x11bc"
msgid "Jetzt weiß ich, wo meine Steuern hingehen."
msgstr "Maintenant je sais où vont mes impôts."

#: script.p20.0x11f2
msgctxt "script.p20.0x11f2"
msgid "CLR Hallo Echo!"
msgstr "CLR Allô Echo !"

