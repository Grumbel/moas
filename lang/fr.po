msgstr "CLR ___KLIRR!___"

#: script.p13.0x1b8f
msgctxt "script.p13.0x1b8f"
msgid "Oooooops!"
msgstr "Oooooops !"

#: script.p13.0x1bab
msgctxt "script.p13.0x1bab"
msgid "Ich glaube, einmal reicht."
msgstr "Je pense qu'une fois suffit."

#: script.p13.0x1f06
msgctxt "script.p13.0x1f06"
msgid "___Au!___"
msgstr "___Ouch!___"

#: script.p13.0x1f17
msgctxt "script.p13.0x1f17"
msgid "__Zurück!__ NW Oder ich piekse!"
msgstr "__Back off!__ NW Or I'll prick you!"

#: script.p13.0x1f38
msgctxt "script.p13.0x1f38"
msgid "Das hast du schon getan!"
msgstr "Tu as déjà fait ça !"

#: script.p13.0x1f4a
msgctxt "script.p13.0x1f4a"
msgid "Stimmt! NW Und ich tu es noch einmal!"
msgstr "That's right! NW And I'll do it again!"

#: script.p13.0x1f68
msgctxt "script.p13.0x1f68"
msgid "___Au!___"
msgstr "___Ouch!___"

#: script.p13.0x1f79
msgctxt "script.p13.0x1f79"
msgid "___Haha!___"
msgstr "___Haha!___"

#: script.p13.0x1f8b
msgctxt "script.p13.0x1f8b"
msgid "Wer bist du?"
msgstr "Who are you?"

#: script.p13.0x1f9a
msgctxt "script.p13.0x1f9a"
msgid "Bist du blind? NW Ich bin ein Kaktus!"
msgstr "T'es aveugle ? NW Je suis un cactus !"

#: script.p13.0x1fb9
msgctxt "script.p13.0x1fb9"
msgid "Ähh. NW Ja."
msgstr "Uh... NW Yes."

#: script.p13.0x1fd3
msgctxt "script.p13.0x1fd3"
msgid "___Grunz!___"
msgstr "___Grunt!___"

#: script.p13.0x1fe6
msgctxt "script.p13.0x1fe6"
msgid "__Zurück!__ NW Oder ich piekse!"
msgstr "__Back off!__ NW Or I'll prick you!"

#: script.p14.0x0016
msgctxt "script.p14.0x0016"
msgid "_"
msgstr "_"

#: script.p14.0x002a
msgctxt "script.p14.0x002a"
msgid "Also, erst einmal"
msgstr "So, first of all"

#: script.p14.0x0046
msgctxt "script.p14.0x0046"
msgid "Dann"
msgstr "Then"

#: script.p14.0x005c
msgctxt "script.p14.0x005c"
msgid "Und dann"
msgstr "And then"

#: script.p14.0x0091
msgctxt "script.p14.0x0091"
msgid "wollte jemand etwas wegen einer Freundin..."
msgstr "someone wanted something concerning a girlfriend..."

#: script.p14.0x00d8
msgctxt "script.p14.0x00d8"
msgid "Aha! Das warst bestimmt du! NW Du suchst also deine Freundin!"
msgstr "Aha ! Ça devait être toi ! NW Alors tu cherches ta petite amie !"

#: script.p14.0x0114
msgctxt "script.p14.0x0114"
msgid "war da irgendjemand, so ein aufdringlicher... NW _"
msgstr "was there someone, some pushy guy... NW _"

#: script.p14.0x0141
msgctxt "script.p14.0x0141"
msgid "war da jemand wegen eines Zettels.. NW _"
msgstr "was there someone asking about a note... NW _"

#: script.p14.0x017c
msgctxt "script.p14.0x017c"
msgid "war da ein Irrer.."
msgstr "was there a lunatic.."

#: script.p14.0x01ba
msgctxt "script.p14.0x01ba"
msgid "Aha! Das kannst nur du sein!"
msgstr "Aha ! Ça ne peut être que toi !"

#: script.p14.0x01e6
msgctxt "script.p14.0x01e6"
msgid "wollte jemand unbedingt herrein... NW _"
msgstr "someone was desperate to get in... NW _"

#: script.p14.0x020f
msgctxt "script.p14.0x020f"
msgid "hatte sich ein Wissenschaftler verlaufen... NW _"
msgstr "a scientist had lost his way... NW _"

