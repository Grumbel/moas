msgid "CLR Der Aufzugmotor ist definitiv kaputt. NW Aber ich kann nicht herran."
msgstr "CLR Le moteur de l'ascenseur est définitivement cassé. NW Mais je ne peux pas l'atteindre."

#. prog 16 @ 03d6 op say_if_found
#: script.p16.0x03d6
msgctxt "script.p16.0x03d6"
msgid "CLR Zu erst einmal müssen die Hornissen weg."
msgstr "CLR D'abord, il faut que les frelons partent."

#. prog 16 @ 0407 op say_if_found
#: script.p16.0x0407
msgctxt "script.p16.0x0407"
msgid "CLR Der Aufzugmotor ist ausgebrannt. NW An reparieren ist nicht zu denken."
msgstr "CLR Le moteur de l'ascenseur a brûlé. NW Pas question de le réparer."

#. prog 16 @ 044c op add_say_window2
#: script.p16.0x044c
msgctxt "script.p16.0x044c"
msgid "Soll ich es mit Handauflegen versuchen?"
msgstr "Je dois essayer l'imposition des mains ?"

#. prog 16 @ 0479 op add_say_window
#: script.p16.0x0479
msgctxt "script.p16.0x0479"
msgid "Jetzt kommt der Reparatur-Expresservice."
msgstr "Voici le service de réparation express."

#. prog 16 @ 04d8 op add_say_window
#: script.p16.0x04d8
msgctxt "script.p16.0x04d8"
msgid "Ich hoffe mir bezahlt jemand den Nachtzuschlag."
msgstr "J'espère que quelqu'un me paie la majoration de nuit."

#. prog 16 @ 0503 op add_say_window2
#: script.p16.0x0503
msgctxt "script.p16.0x0503"
msgid "CLR ____(6_Punkte)____ NW (Plus 50 Prozent Nachtzuschlag)"
msgstr "CLR ____(6 points)____ NW (Plus 50 pour cent de majoration de nuit)"

#. prog 16 @ 0542 op say_if_found
#: script.p16.0x0542
msgctxt "script.p16.0x0542"
msgid "CLR Der Aufzugmotor funktioniert. NW Aber er ist stark magnetisch."
msgstr "CLR Le moteur de l'ascenseur fonctionne. NW Mais il est fortement magnétique."

#. prog 16 @ 0587 op add_say_window2
#: script.p16.0x0587
msgctxt "script.p16.0x0587"
msgid "Der Motor funktioniert prima."
msgstr "Le moteur fonctionne parfaitement."

#. prog 16 @ 05c5 op say_if_found
#: script.p16.0x05c5
msgctxt "script.p16.0x05c5"
msgid "CLR Ein Hornissennest. NW Zum Glück sind die Hornissen weg."
msgstr "CLR Un nid de frelons. NW Heureusement, les frelons sont partis."

#. prog 16 @ 0601 op add_say_window
#: script.p16.0x0601
msgctxt "script.p16.0x0601"
msgid "Besser nicht. Denn.."
msgstr "Mieux vaut ne pas. Car.."

#. prog 16 @ 061a op add_say_window2
#: script.p16.0x061a
msgctxt "script.p16.0x061a"
msgid "..manchmal kommen sie wieder!"
msgstr "..parfois ils reviennent !"

#. prog 16 @ 063f op say_if_found
#: script.p16.0x063f
msgctxt "script.p16.0x063f"
msgid "CLR Hornissen. NW Die sind faustdick!"
msgstr "CLR Des frelons. NW Ils sont gros comme le poing !"

#. prog 16 @ 066d op add_say_window2
#: script.p16.0x066d
msgctxt "script.p16.0x066d"
msgid "Dafür hänge ich zu sehr am Leben."
msgstr "J'y tiens trop à la vie pour ça."

#. prog 16 @ 069f op say_if_found
#: script.p16.0x069f
msgctxt "script.p16.0x069f"
msgid "CLR Da glitzert was drin."
msgstr "CLR Quelque chose brille dedans."

#. prog 16 @ 06c4 op say_if_found
#: script.p16.0x06c4
msgctxt "script.p16.0x06c4"
msgid "CLR Ich krieg sie nicht auf!"
msgstr "CLR Je n'arrive pas à l'ouvrir !"

#. prog 16 @ 06dc op say_if_found
#: script.p16.0x06dc
msgctxt "script.p16.0x06dc"
msgid "CLR Die Kiste ist zugenagelt. NW Mit einem Messer habe ich keine Chance!"
msgstr "CLR La caisse est clouée. NW Avec un couteau, je n'ai aucune chance !"

#. prog 16 @ 070c op say_if_found
#: script.p16.0x070c
msgctxt "script.p16.0x070c"
msgid "CLR Jau, damit könnte es gehen. NW Könnte es, falls der Programmierer an diese Möglichkeit gedacht hätte. NW Hat er aber nicht. NW Und deshalb geht's auch nicht."
msgstr "CLR Ouais, ça pourrait marcher. NW Ça pourrait, si le programmeur avait pensé à cette possibilité. NW Mais il n'y a pas pensé. NW Donc ça ne marche pas."

#. prog 16 @ 07be op add_say_window2
#: script.p16.0x07be
msgctxt "script.p16.0x07be"
msgid "CLR Autsch!"
msgstr "CLR Aïe !"

#. prog 17 @ 000c op set_room_name
#: script.p17.0x000c
msgctxt "script.p17.0x000c"
msgid "Unter dem Dach"
msgstr "Sous le toit"

#. prog 18 @ 000c op set_room_name
#: script.p18.0x000c
msgctxt "script.p18.0x000c"
msgid "Bei der Maschine"
msgstr "Près de la machine"

#. prog 19 @ 000c op set_room_name
#: script.p19.0x000c
msgctxt "script.p19.0x000c"
msgid "im Kinderzimmer"
msgstr "dans la chambre d'enfants"

#. prog 20 @ 0031 op set_room_name
#: script.p20.0x0031
msgctxt "script.p20.0x0031"
msgid "Im Vorzimmer zum Labor"
msgstr "Dans l'antichambre du laboratoire"

#. prog 23 @ 000c op set_room_name
#: script.p23.0x000c
msgctxt "script.p23.0x000c"
msgid "Im Kellergang"
msgstr "Dans le couloir de cave"

#. prog 24 @ 000c op set_room_name
#: script.p24.0x000c
msgctxt "script.p24.0x000c"
msgid "Im Wohnzimmer"
msgstr "Dans le salon"

#. prog 25 @ 0018 op set_room_name
#: script.p25.0x0018
msgctxt "script.p25.0x0018"
msgid "Im Garten"
msgstr "Dans le jardin"

#. prog 25 @ 00cf op set_room_name
#: script.p25.0x00cf
msgctxt "script.p25.0x00cf"
msgid "In der Gameshow"
msgstr "Dans le jeu télévisé"

#. prog 26 @ 0013 op set_room_name
#: script.p26.0x0013
msgctxt "script.p26.0x0013"
msgid "Showdown"
msgstr "Showdown"

#. prog 25 @ 015f op add_say_window
#: script.p25.0x015f
msgctxt "script.p25.0x015f"
msgid "Oh (Räusper) NW Willkommen bei \"Win or Win\". NW Bei der Gameshow die nur Gewinner kennt. NW Gesponsort von \"Wild\", der tollen Zeitung."
msgstr "Oh (raclement de gorge) NW Bienvenue à « Win or Win ». NW Le jeu télévisé qui ne connaît que des gagnants. NW Sponsorisé par « Wild », le super journal."

#. prog 25 @ 01be op add_say_window
#: script.p25.0x01be
msgctxt "script.p25.0x01be"
msgid "Schicken aus Sie Ihre Beiträge an die \"Wild\". NW Denn nur die \"Wild\" veröffentlicht auch wirklich ALLES!"
msgstr "Envoyez vos contributions à « Wild ». NW Car seul « Wild » publie vraiment TOUT !"

#. prog 25 @ 0205 op add_say_window
#: script.p25.0x0205
msgctxt "script.p25.0x0205"
msgid "So, wir begrüßen nun unseren ersten Kandidaten, äh.."
msgstr "Alors, accueillons maintenant notre premier candidat, euh.."

#. prog 25 @ 022d op add_say_window
#: script.p25.0x022d
msgctxt "script.p25.0x022d"
msgid "___Jack___"
msgstr "___Jack___"

#. prog 25 @ 023e op add_say_window
#: script.p25.0x023e
msgctxt "script.p25.0x023e"
msgid "Die Antwort ist richtig. NW Damit haben Sie schon die Reise nach Timbuktu gewonnen. NW Aber Jack kann noch viel mehr gewinnen. NW Gleich nach der Werbung."
msgstr "La réponse est correcte. NW Vous avez déjà gagné le voyage à Tombouctou. NW Mais Jack peut gagner bien plus. NW Juste après la publicité."

#. prog 25 @ 0299 op add_say_window
#: script.p25.0x0299
msgctxt "script.p25.0x0299"
msgid "Wo bleibt die Maske. NW Mein Toupet ist verrutscht. NW Die dumme Pute ist gefeuert."
msgstr "Où est le maquillage. NW Ma perruque a glissé. NW Cette idiote est virée."

#. prog 25 @ 02d5 op add_say_window
#: script.p25.0x02d5
msgctxt "script.p25.0x02d5"
msgid "Ja und da sind wir wieder bei \"Win or Win\". NW Jetzt geht es um den Superpreis. NW Genau! DM 100.000 in Bar. NW Gleich zum mitnehmen."
msgstr "Oui et nous voici de nouveau à « Win or Win ». NW Maintenant, c'est le super prix. NW Exactement ! 100 000 marks en espèces. NW À emporter tout de suite."

#. prog 25 @ 0373 op add_say_window
#: script.p25.0x0373
msgctxt "script.p25.0x0373"
msgid "Entspannen Sie sich, Jack. NW Wir sind hier unter uns."
msgstr "Détendez-vous, Jack. NW Nous sommes entre nous ici."

#. prog 25 @ 03ea op add_say_window
#: script.p25.0x03ea
msgctxt "script.p25.0x03ea"
msgid "Frage Nr. 1: Wieviele Köpfe hat der Sage nach die dreiköpfige Hydra?"
msgstr "Question n°1 : Selon la légende, combien de têtes a l'Hydre à trois têtes ?"

#. prog 25 @ 0421 op add_option
#: script.p25.0x0421
msgctxt "script.p25.0x0421"
msgid "Einen."
msgstr "Une."

#. prog 25 @ 042f op add_option
#: script.p25.0x042f
msgctxt "script.p25.0x042f"
msgid "Zwei. Einen für jedes Auge, wovon sie vier hat."
msgstr "Deux. Une pour chaque œil, et elle en a quatre."

#. prog 25 @ 0455 op add_option
#: script.p25.0x0455
msgctxt "script.p25.0x0455"
msgid "Zweiundvierzig."
msgstr "Quarante-deux."

#. prog 25 @ 0469 op add_option
#: script.p25.0x0469
msgctxt "script.p25.0x0469"
msgid "Das ist eine Fangfrage. Hydren sind keine Tieren, sondern Pflanzen die sich nur für Tiere halten."
msgstr "C'est une question piège. Les hydres ne sont pas des animaux, mais des plantes qui se prennent seulement pour des animaux."

#. prog 25 @ 04a2 op add_option
#: script.p25.0x04a2
msgctxt "script.p25.0x04a2"
msgid "Rembrandt?"
msgstr "Rembrandt ?"

#. prog 25 @ 04c2 op add_say_window2
#: script.p25.0x04c2
msgctxt "script.p25.0x04c2"
msgid "____(3_Punkte)____"
msgstr "____(3 points)____"

#. prog 25 @ 04d4 op add_say_window
#: script.p25.0x04d4
msgctxt "script.p25.0x04d4"
msgid "Ich denke, das können wir gelten lassen."
msgstr "Je pense que nous pouvons accepter ça."

#. prog 25 @ 04f5 op add_say_window
#: script.p25.0x04f5
msgctxt "script.p25.0x04f5"
msgid "Frage Nr. 2: Wenn Sie eine Tasse Tee umrühren und dabei beobachten, wo sich die Teeblätter sammeln. NW Welche Farbe hat dann der Tee?"
msgstr "Question n°2 : Si vous remuez une tasse de thé et observez où se rassemblent les feuilles de thé. NW Quelle est alors la couleur du thé ?"

#. prog 25 @ 0551 op add_option
#: script.p25.0x0551
msgctxt "script.p25.0x0551"
msgid "Er ist klar. Ansonsten könnte man die Teeblätter nicht sehen."
msgstr "Il est clair. Sinon on ne pourrait pas voir les feuilles de thé."

#. prog 25 @ 057e op add_option
#: script.p25.0x057e
msgctxt "script.p25.0x057e"
msgid "Roter Tee. Alle anderen Teesorten gehören, wie sicherlich jederman weiß, zu der Gattung der Nachtschattengewächse, deren Blätter man so fein zermalen kann, daß man sie nicht sieht."
msgstr "Thé rouge. Toutes les autres sortes de thé appartiennent, comme tout le monde le sait, à la famille des solanacées, dont on peut moudre les feuilles si finement qu'on ne les voit pas."

#. prog 25 @ 05e7 op add_option
#: script.p25.0x05e7
msgctxt "script.p25.0x05e7"
msgid "Grüner Tee. Ich kann den Flecken auf Ihrer Hose sehen, den Sie beim Ausprobieren gemacht haben."
msgstr "Thé vert. Je peux voir la tache sur votre pantalon que vous avez faite en essayant."

#. prog 25 @ 0625 op add_option
#: script.p25.0x0625
msgctxt "script.p25.0x0625"
msgid "Kann ich die Frage noch einmal hören?"
msgstr "Puis-je entendre la question une nouvelle fois ?"

#. prog 25 @ 063f op add_option
#: script.p25.0x063f
msgctxt "script.p25.0x063f"
msgid "Rembrandt?"
msgstr "Rembrandt ?"

#. prog 25 @ 065f op add_say_window2
#: script.p25.0x065f
msgctxt "script.p25.0x065f"
msgid "____(6_Punkte)____"
msgstr "____(6 points)____"

#. prog 25 @ 0671 op add_say_window
#: script.p25.0x0671
msgctxt "script.p25.0x0671"
msgid "Ja, das ist fast perfekt. NW Tadellos!"
msgstr "Oui, c'est presque parfait. NW Impeccable !"

#. prog 25 @ 0695 op add_say_window
#: script.p25.0x0695
msgctxt "script.p25.0x0695"
msgid "Und nun zur dritten und entscheidenen Frage! NW Bewahren Sie die Nerven, wir kommen zu einem komplexen, physikalischen Thema: NW Wie heißt der Entdecker von Einsteins Relativitätstheorie?"
msgstr "Et maintenant la troisième et décisive question ! NW Gardez votre calme, nous arrivons à un sujet de physique complexe : NW Comment s'appelle le découvreur de la théorie de la relativité d'Einstein ?"

#. prog 25 @ 0709 op add_option
#: script.p25.0x0709
msgctxt "script.p25.0x0709"
msgid "Einstein."
msgstr "Einstein."

#. prog 25 @ 0718 op add_option
#: script.p25.0x0718
msgctxt "script.p25.0x0718"
msgid "Zweistein."
msgstr "Zweistein."

#. prog 25 @ 0728 op add_option
#: script.p25.0x0728
msgctxt "script.p25.0x0728"
msgid "Dreistein."
msgstr "Dreistein."

#. prog 25 @ 0738 op add_option
#: script.p25.0x0738
msgctxt "script.p25.0x0738"
msgid "Zahnstein."
msgstr "Tartre."

#. prog 25 @ 0749 op add_option
#: script.p25.0x0749
msgctxt "script.p25.0x0749"
msgid "Rembrandt?"
msgstr "Rembrandt ?"

#. prog 25 @ 0769 op add_say_window2
#: script.p25.0x0769
msgctxt "script.p25.0x0769"
msgid "____(9_Punkte)____"
msgstr "____(9 points)____"

#. prog 25 @ 077b op add_say_window
#: script.p25.0x077b
msgctxt "script.p25.0x077b"
msgid "___Korrekt!___ NW Sie haben einen Koffer voller Geld gewonnen!"
msgstr "___Correct !___ NW Vous avez gagné une valise pleine d'argent !"

#. prog 25 @ 07fb op add_say_window
#: script.p25.0x07fb
msgctxt "script.p25.0x07fb"
msgid "Was sagen Sie nun, Jack!"
msgstr "Que dites-vous maintenant, Jack !"

#. prog 25 @ 0810 op add_say_window
#: script.p25.0x0810
msgctxt "script.p25.0x0810"
msgid "Eigentlich bräuchte ich ja nur den Koffer. NW Ich meine, wenn das ginge..."
msgstr "En fait, j'aurais seulement besoin de la valise. NW Je veux dire, si c'était possible..."

#. prog 26 @ 009f op add_say_window
#: script.p26.0x009f
msgctxt "script.p26.0x009f"
msgid "____(13_Punkte)____"
msgstr "____(13 points)____"

#. prog 26 @ 00b2 op add_say_window2
#: script.p26.0x00b2
msgctxt "script.p26.0x00b2"
msgid "____Sandy!____ NW Halt durch, ich komme und rette dich!"
msgstr "____Sandy!____ NW Tiens bon, j'arrive et je te sauve !"

#. prog 26 @ 00e8 op add_say_window
#: script.p26.0x00e8
msgctxt "script.p26.0x00e8"
msgid "CLR Du bist ja gar nicht Sandy!"
msgstr "CLR Tu n'es pas du tout Sandy !"

#. prog 26 @ 0111 op add_say_window2
#: script.p26.0x0111
msgctxt "script.p26.0x0111"
msgid "Was geht hier vor?"
msgstr "Que se passe-t-il ici ?"

#. prog 26 @ 0134 op add_say_window
#: script.p26.0x0134
msgctxt "script.p26.0x0134"
msgid "CLR Ich bin gekommen um meine Freundin zu retten!"
msgstr "CLR Je suis venu sauver ma petite amie !"

#. prog 26 @ 0158 op add_say_window
#: script.p26.0x0158
msgctxt "script.p26.0x0158"
msgid "CLR Würde mich bitte hier jemand losbinden?"
msgstr "CLR Est-ce que quelqu'un pourrait me détacher, s'il vous plaît ?"

#. prog 26 @ 017d op add_say_window
#: script.p26.0x017d
msgctxt "script.p26.0x017d"
msgid "CLR Wo ist meine Freundin!?"
msgstr "CLR Où est ma petite amie !?"

#. prog 26 @ 0197 op add_say_window
#: script.p26.0x0197
msgctxt "script.p26.0x0197"
msgid "CLR Würdest du mich bitte losbinden!"
msgstr "CLR Pourrais-tu me détacher, s'il te plaît !"

#. prog 26 @ 01b4 op add_say_window
#: script.p26.0x01b4
msgctxt "script.p26.0x01b4"
msgid "CLR Ruhe!"
msgstr "CLR Silence !"

#. prog 26 @ 01c4 op add_say_window
#: script.p26.0x01c4
msgctxt "script.p26.0x01c4"
msgid "CLR Willst du sie jetzt retten oder nicht?"
msgstr "CLR Tu veux la sauver maintenant ou non ?"

#. prog 26 @ 01e0 op add_say_window
#: script.p26.0x01e0
msgctxt "script.p26.0x01e0"
msgid "CLR Ich suche Sandy! NW Was haben Sie mit Sandy gemacht!?"
msgstr "CLR Je cherche Sandy ! NW Qu'avez-vous fait de Sandy !?"

#. prog 26 @ 0205 op add_say_window
#: script.p26.0x0205
msgctxt "script.p26.0x0205"
msgid "CLR ___Sandy?___ NW Die habe ich in eine Kaktee verwandelt!"
msgstr "CLR ___Sandy?___ NW Je l'ai transformée en cactus !"

#. prog 26 @ 022f op add_say_window
#: script.p26.0x022f
msgctxt "script.p26.0x022f"
msgid "CLR SIE HABEN WAS....!?"
msgstr "CLR VOUS AVEZ FAIT QUOI....!?"

#. prog 26 @ 024c op add_say_window
#: script.p26.0x024c
msgctxt "script.p26.0x024c"
msgid "CLR Ganz richtig, mit der Maschine dort rechts. NW Deine Freundin steht jetzt im Vorgarten. NW Und DICH werde ich jetzt entgültig zerstrahlen!"
msgstr "CLR Exactement, avec la machine là à droite. NW Ta petite amie est maintenant dans le jardin de devant. NW Et TOI, je vais te désintégrer définitivement !"

#. prog 26 @ 02e3 op add_say_window
#: script.p26.0x02e3
msgctxt "script.p26.0x02e3"
msgid "____Halt!____"
msgstr "____Arrête!____"

#. prog 26 @ 02f1 op add_say_window
#: script.p26.0x02f1
msgctxt "script.p26.0x02f1"
msgid "Leg die Waffe weg! NW Du weißt nicht, was du da in der Hand hast!"
msgstr "Pose l'arme ! NW Tu ne sais pas ce que tu as dans la main !"

#. prog 26 @ 031f op add_say_window
#: script.p26.0x031f
msgctxt "script.p26.0x031f"
msgid "Das ist für Sandy!"
msgstr "C'est pour Sandy !"

#. prog 26 @ 034b op add_say_window2
#: script.p26.0x034b
msgctxt "script.p26.0x034b"
msgid "____Ahhh!____"
msgstr "____Ahhh!____"

#. prog 26 @ 0378 op add_say_window
#: script.p26.0x0378
msgctxt "script.p26.0x0378"
msgid "Was hast du getan? NW _____OH_NEIN!_____"
msgstr "Qu'as-tu fait ? NW _____OH_NON!_____"

#. prog 26 @ 05d1 op add_say_window
#: script.p26.0x05d1
msgctxt "script.p26.0x05d1"
msgid "Ich schätze, von diesem Spiel wird es keinen zweiten Teil geben..."
msgstr "Je pense qu'il n'y aura pas de suite à ce jeu..."

#. prog 26 @ 05ff op add_say_window2
#: script.p26.0x05ff
msgctxt "script.p26.0x05ff"
msgid "Wenn Sandy jetzt eine Kaktee ist,.. NW ..dann gibt es nur eines!"
msgstr "Si Sandy est maintenant un cactus,.. NW ..alors il n'y a qu'une chose à faire !"

#. prog 26 @ 068b op add_say_window
#: script.p26.0x068b
msgctxt "script.p26.0x068b"
msgid "Sandy, ich komme!"
msgstr "Sandy, j'arrive !"

#. prog 26 @ 0784 op add_say_window
#: script.p26.0x0784
msgctxt "script.p26.0x0784"
msgid "Naja, zumindest leben die Beiden lange!"
msgstr "Bon, au moins les deux vivront longtemps !"

#. prog 26 @ 07a5 op add_say_window
#: script.p26.0x07a5
msgctxt "script.p26.0x07a5"
msgid "Was meinst du, ob die Fete bei Alice schon vorbei ist?"
msgstr "Tu penses que la fête chez Alice est déjà finie ?"

#. prog 26 @ 07ce op add_say_window
#: script.p26.0x07ce
msgctxt "script.p26.0x07ce"
msgid "Schauen wir mal nach."
msgstr "Allons voir."

