msgstr "____(5_points)____"

#: script.p20.0x0b02
msgctxt "script.p20.0x0b02"
msgid "CLR ____Kein_Problem.____ NW Ich hab' mal 'ne Zeitlang Pizzas ausgeliefert. NW Und seitdem.."
msgstr "CLR ____Pas_de_problème.____ NW J'ai livré des pizzas un moment. NW Et depuis.."

