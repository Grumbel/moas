msgid "__Ed!__"
msgstr "__Ed!__"

#. prog 12 @ 0cd9 op add_say_window
#: script.p12.0x0cd9
msgctxt "script.p12.0x0cd9"
msgid "Mishandelst du etwa wieder unsere Gäste?"
msgstr "Are you mistreating our guests again?"

#. prog 12 @ 0cf8 op add_say_window
#: script.p12.0x0cf8
msgctxt "script.p12.0x0cf8"
msgid "Aber meine Liebe! NW Ich doch nicht!"
msgstr "But my dear! NW I would never!"

#. prog 12 @ 0d12 op add_say_window
#: script.p12.0x0d12
msgctxt "script.p12.0x0d12"
msgid "Dann tu bitte endlich etwas gegen die Ratten! NW Ich hasse Ratten. NW Die Biester sind eine echte Plage."
msgstr "Then please do something about the rats at last! NW I hate rats. NW Those beasts are a real nuisance."

#. prog 12 @ 0d48 op add_say_window
#: script.p12.0x0d48
msgctxt "script.p12.0x0d48"
msgid "Aber das sind Mäuse."
msgstr "But those are mice."

#. prog 12 @ 0d5a op add_say_window
#: script.p12.0x0d5a
msgctxt "script.p12.0x0d5a"
msgid "Egal, ich bin flexibel. Ich hasse Ratten UND Mäuse. NW Und das Hornissennest unter dem Dach!"
msgstr "Whatever, I'm flexible. I hate rats AND mice. NW And that hornets' nest under the roof!"

#. prog 12 @ 0d93 op add_say_window
#: script.p12.0x0d93
msgctxt "script.p12.0x0d93"
msgid "(grummel)"
msgstr "(grumble)"

#. prog 12 @ 0da3 op add_say_window
#: script.p12.0x0da3
msgctxt "script.p12.0x0da3"
msgid "Und die Haustür muß auch wieder gestrichen werden! NW Und... NW ..tapeziert.. NW ..repariert.. NW ..defekt.."
msgstr "And the front door needs repainting, too! NW And... NW ...new wallpaper... NW ...repairs... NW ...broken..."

#. prog 12 @ 0dea op add_say_window2
#: script.p12.0x0dea
msgctxt "script.p12.0x0dea"
msgid "..Gartenzaun.."
msgstr "...garden fence..."

